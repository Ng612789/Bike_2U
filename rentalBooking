            cout << "Customer     : " << p.customerName << "\n";
            cout << "Amount Paid  : RM " << fixed << setprecision(2) << p.paymentAmount << "\n";
            cout << "Method       : " << p.paymentMethod << "\n";
            cout << "Date         : " << p.paymentDate << "\n";
